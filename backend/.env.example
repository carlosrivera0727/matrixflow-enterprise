APP_NAME="MatrixFlow Enterprise API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
API_PREFIX="/api/v1"

# SQLite local. Puede reemplazarse por otra URL compatible con SQLAlchemy.
DATABASE_URL="sqlite:///./matrixflow.db"

# Pydantic Settings interpreta esta variable como una lista JSON.
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
CORS_ALLOW_CREDENTIALS=true

# Reemplazar por un valor largo y aleatorio fuera del entorno local.
JWT_SECRET_KEY="change-this-secret-before-production"
JWT_ALGORITHM="HS256"
JWT_ISSUER="matrixflow-enterprise"
JWT_AUDIENCE="matrixflow-frontend"
ACCESS_TOKEN_EXPIRE_MINUTES=60
